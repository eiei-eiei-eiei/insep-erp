# ── Supabase (จาก dashboard → Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public ได้ (RLS คุมสิทธิ์ฝั่ง DB)
SUPABASE_SERVICE_ROLE_KEY=          # ⛔ server-only: migration script + upload templates เท่านั้น ห้ามเข้า client bundle

# ── AI สแกนใบเสร็จ (Phase 3) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # rotate ใหม่ (key เดิมถือว่า leaked)
SCAN_DAILY_LIMIT=100

# ── LINE Notify ฝั่งขาย (Phase 4, server-only) ─────────────────────────────────
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=

# ── ค่าคงที่ธุรกิจ ──────────────────────────────────────────────────────────────
DEFAULT_ENTITY_ID=EID01
LIQUOR_ENTITY_ID=EID01

# โดเมนอีเมลภายในสำหรับ login แบบ username (ไม่ต้องมีอีเมลจริง) — username จะกลายเป็น <username>@<domain>
LOGIN_EMAIL_DOMAIN=insep.local

# ── เฉพาะถ้าใช้ legacy webhook bridge (sec 8.4) — สุ่มใหม่ ห้ามใช้ token เดิม ───────
LEGACY_WEBHOOK_TOKEN=
