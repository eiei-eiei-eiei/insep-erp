# ── Supabase (จาก dashboard → Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public ได้ (RLS คุมสิทธิ์ฝั่ง DB)
SUPABASE_SERVICE_ROLE_KEY=          # ⛔ server-only: migration script + upload templates เท่านั้น ห้ามเข้า client bundle

# ── AI สแกนใบเสร็จ (Phase 3) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # rotate ใหม่ (key เดิมถือว่า leaked)
SCAN_DAILY_LIMIT=100

# ── LINE Notify ฝั่งขาย (Phase 4, server-only) ─────────────────────────────────
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=

# ── ค่าคงที่ธุรกิจ ──────────────────────────────────────────────────────────────
DEFAULT_ENTITY_ID=EID01
LIQUOR_ENTITY_ID=EID01

# โดเมนอีเมลภายในสำหรับ login แบบ username (ไม่ต้องมีอีเมลจริง) — username จะกลายเป็น <username>@<domain>
LOGIN_EMAIL_DOMAIN=insep.local

# ── เฉพาะถ้าใช้ legacy webhook bridge (sec 8.4) — สุ่มใหม่ ห้ามใช้ token เดิม ───────
LEGACY_WEBHOOK_TOKEN=

# ── multi-tenant: โดเมนหลักของแพลตฟอร์ม (ว่าง = โหมดลิงก์เดียว ไม่ใช้ subdomain) ────
# ตั้งเมื่อขายลูกค้าจริงแล้วให้เข้าผ่าน <ลูกค้า>.โดเมนนี้ · เทสในเครื่องใช้ <slug>.localhost:3000 ได้เลย
NEXT_PUBLIC_ROOT_DOMAIN=

# ══ เทสกันข้อมูลรั่ว (npm run test:tenant) — ใส่ในไฟล์แยก ══
#    ชื่อไฟล์: .env.tenant-test.local (หรือ .env.tenant-test ก็ได้)
#
# 🚨 ห้ามใส่ค่าพวกนี้ใน .env.local เด็ดขาด — เทสชุดนี้สร้างและ "ลบ" ข้อมูลจริง
#    ต้องชี้ไปที่ Supabase project ที่ทิ้งได้เท่านั้น ไม่ใช่ DB ที่ใช้ยื่นภาษี
#    (ค่าเอาจาก Dashboard → Project Settings → API ของ project ทดสอบ)
#
# TENANT_TEST_SUPABASE_URL=https://<ref>.supabase.co
# TENANT_TEST_SERVICE_ROLE_KEY=
# TENANT_TEST_ANON_KEY=
# TENANT_TEST_CONFIRM=disposable
